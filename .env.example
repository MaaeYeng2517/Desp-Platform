# Data Engineering Workflow Platform - Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2
AIRFLOW_PROJ_DIR=.
ENV_FILE_PATH=.env

# Airflow Security (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Airflow API Authentication
AIRFLOW__API_AUTH__JWT_SECRET=your-jwt-secret-here
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow Admin User
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Additional pip packages for Airflow containers
_PIP_ADDITIONAL_REQUIREMENTS=mem0==1.1.0 pyspark==4.0.0 minio==7.2.0 openlineage-airflow==1.8.0

# =============================================================================
# PostgreSQL (Data Warehouse)
# =============================================================================
DB_HOST=datawarehouse
DB_PORT=5432
DB_USER=dataeng
DB_PASSWORD=dataeng
DB_NAME=datawarehouse
PGPASSWORD=dataeng

# =============================================================================
# MinIO (Data Lake)
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# =============================================================================
# Redis (Airflow Celery Broker)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Spark
# =============================================================================
SPARK_MASTER_URL=spark://spark-master:7077

# =============================================================================
# OpenLineage (Data Lineage)
# =============================================================================
OPENLINEAGE_ENDPOINT=http://marquez:5000
OPENLINEAGE_API_KEY=
OPENLINEAGE_NAMESPACE=data-platform

# =============================================================================
# Monitoring (Prometheus/Grafana)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# dbt
# =============================================================================
DBT_PROFILES_DIR=~/.dbt

# =============================================================================
# Apache Atlas (Metadata Catalog)
# =============================================================================
ATLAS_IMAGE=sburn/apache-atlas:2.3.0
ATLAS_PORT=21000
ATLAS_USERNAME=admin
ATLAS_PASSWORD=admin
ATLAS_SERVER_HEAP=1536m
ATLAS_CLUSTER=data-platform

# =============================================================================
# Embedded Analytics
# =============================================================================
EMBED_TOKEN_SECRET=your-embed-token-secret-here
EMBED_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=["*"]